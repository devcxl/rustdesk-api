#!/bin/sh
set -e

SERVICE=rustdesk-api.service
DATA_DIR=/var/lib/rustdesk-api
LOG_DIR=/var/log/rustdesk-api
RUN_USER=rustdesk-api

if [ "$1" = "configure" ]; then
    # Dedicated system account; the service must not run as root.
    if ! getent group "${RUN_USER}" >/dev/null; then
        addgroup --system "${RUN_USER}"
    fi
    if ! getent passwd "${RUN_USER}" >/dev/null; then
        adduser --system --ingroup "${RUN_USER}" --home "${DATA_DIR}" \
            --no-create-home --disabled-login "${RUN_USER}"
    fi

    mkdir -p "${DATA_DIR}/data" "${DATA_DIR}/runtime" "${LOG_DIR}"
    chown -R "${RUN_USER}:${RUN_USER}" "${DATA_DIR}/data" "${DATA_DIR}/runtime" "${LOG_DIR}"
    chmod 0750 "${DATA_DIR}/data" "${DATA_DIR}/runtime" "${LOG_DIR}"

    # The config may hold the RustDesk key, JWT key and OAuth secrets.
    if [ -f "${DATA_DIR}/conf/config.yaml" ]; then
        chown root:"${RUN_USER}" "${DATA_DIR}/conf/config.yaml"
        chmod 0640 "${DATA_DIR}/conf/config.yaml"
    fi
fi

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
      mkdir -p /var/lib/rustdesk-api/
	  deb-systemd-helper unmask "${SERVICE}" >/dev/null || true
	  if deb-systemd-helper --quiet was-enabled "${SERVICE}"; then
		deb-systemd-invoke enable "${SERVICE}" >/dev/null || true
	  else
		deb-systemd-invoke update-state "${SERVICE}" >/dev/null || true
	  fi
	  systemctl --system daemon-reload >/dev/null || true
	  if [ -n "$2" ]; then
		deb-systemd-invoke restart "${SERVICE}" >/dev/null || true
	  else
		deb-systemd-invoke start "${SERVICE}" >/dev/null || true
	  fi
    ;;
esac

exit 0
